rules_version = '2';

// 서해링 Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > 규칙 탭에 이 내용을 그대로 붙여 넣고 "게시"를 누르세요.
service cloud.firestore {
  match /databases/{database}/documents {

    // 이벤트: 누구나 읽을 수 있고, 관리자 계정만 등록·수정·삭제할 수 있어요.
    // 관리자를 더 늘리려면 아래 목록에 이메일을 추가하고,
    // Authentication에서 그 이메일로 계정을 먼저 만들어 두세요.
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email in ["admin@seohaering.app"];
    }

    // 그 밖의 모든 곳은 막아 둬요.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
